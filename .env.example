# Copiá este archivo como .env y completá los valores.
# NUNCA subas el .env real a git ni lo incluyas en un zip que compartas.

# --- Sesiones y cifrado ---
FLASK_SECRET_KEY=
# 32 bytes en base64. Generala con:
#   python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
# No la cambies sin re-cifrar: perdés los chats y las cuentas bancarias ya guardados.
CHAT_MASTER_KEY=

# --- Base de datos ---
AHORAQUE_DB_URL=

# --- IA (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Correo (Brevo) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Ahora Qué
CONTACTO_EMAIL=ahora.que.app@gmail.com

# --- Notificaciones push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ahora.que.app@gmail.com

# --- Moderación de Social: mails de quienes pueden revisar reportes, separados por coma ---
SOCIAL_MODERADORES=

# --- Premium (demostración) ---
# En tu computadora la demo está siempre encendida. En producción (Render) solo funciona
# con PREMIUM_DEMO=1; sin esta variable, /premium/pagar no activa nada.
PREMIUM_DEMO=1

# --- Quién vende Premium (completar cuando exista un titular real) ---
PROVEEDOR_RAZON_SOCIAL=
PROVEEDOR_RUT=
PROVEEDOR_DOMICILIO=
PROVEEDOR_EMAIL=ahora.que.app@gmail.com
